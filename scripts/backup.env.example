# Copier en ~/odos-config/backup.env (compte deploy, chmod 600). Jamais commité.
# Lu par scripts/prod-backup.sh et scripts/prod-restore-test.sh.
# Mise en place pas à pas : docs/ops/RUNBOOK_SAUVEGARDES.md

# ── Copie hors site chiffrée (restic) ──
# Mot de passe de chiffrement du dépôt : SANS LUI, LES SAUVEGARDES SONT ILLISIBLES.
# Le garder aussi hors du VPS (gestionnaire de mots de passe).
#   openssl rand -base64 32 > ~/odos-config/restic-password && chmod 600 ~/odos-config/restic-password
RESTIC_PASSWORD_FILE=/home/deploy/odos-config/restic-password

# Option A (recommandée, données en Allemagne) : Hetzner Storage Box en SFTP (port 23).
# « storagebox » est un alias défini dans ~/.ssh/config du compte deploy.
RESTIC_REPOSITORY=sftp:storagebox:odos-restic

# Option B : Backblaze B2 (choisir la région EU Central à la création du compte).
# RESTIC_REPOSITORY=b2:odos-backups:vps
# B2_ACCOUNT_ID=<keyID de la clé applicative limitée au bucket>
# B2_ACCOUNT_KEY=<applicationKey>

# Option C : tout stockage S3 (Scaleway, OVH, B2 en S3…).
# RESTIC_REPOSITORY=s3:https://s3.fr-par.scw.cloud/odos-backups/vps
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Rétention hors site (instantanés restic).
# OFFSITE_KEEP_DAILY=7
# OFFSITE_KEEP_WEEKLY=5
# OFFSITE_KEEP_MONTHLY=6

# ── Ping de succès / échec (healthchecks.io, check « odos-backup », période 1 jour, grâce 2 h) ──
HC_BACKUP_PING_URL=https://hc-ping.com/<uuid>

# ── Métrique pour node-exporter (collecteur textfile) ──
# NODE_EXPORTER_TEXTFILE_DIR=/var/lib/node_exporter/textfile

# ── Rétention locale ──
# KEEP_DAILY=7
# KEEP_WEEKLY=4
# KEEP_PREDEPLOY_DAYS=14
