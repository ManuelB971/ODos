# Copier en .env (chmod 600), jamais commité.
#   GRAFANA_ADMIN_PASSWORD : openssl rand -base64 24
GRAFANA_ADMIN_PASSWORD=

# Rôle Postgres en lecture seule dédié (membre de pg_monitor), créé ainsi :
#   docker exec -i odos-postgres-1 psql -U odos -d odos \
#     -c "CREATE ROLE monitoring LOGIN PASSWORD '<mot de passe>' IN ROLE pg_monitor;"
POSTGRES_EXPORTER_DSN=postgresql://monitoring:<mot de passe>@postgres:5432/odos?sslmode=disable

# Notifications (Alertmanager). Les URL ne vont PAS dans ce fichier : chacune
# est un fichier d'une ligne, lisible par l'utilisateur nobody du conteneur
# (dossier 700, fichier 644). Chemins par défaut : ./secrets/<nom>.
#   discord_webhook_url : Discord → salon → Paramètres → Intégrations → Webhooks
#   watchdog_ping_url   : https://hc-ping.com/<uuid> (check « odos-watchdog »,
#                         période 5 min, délai de grâce 5 min)
# DISCORD_WEBHOOK_URL_FILE=./secrets/discord_webhook_url
# WATCHDOG_PING_URL_FILE=./secrets/watchdog_ping_url
