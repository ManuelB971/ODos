# /etc/logrotate.d/nginx — remplace le fichier du paquet (même nom, sinon logrotate
# refuse les entrées en double). Procédure : docs/ops/RUNBOOK_DURCISSEMENT_HOTE.md § 6
#
# access.log / error.log contiennent les IP des visiteurs : rétention de 6 mois,
# dans la fourchette recommandée par la CNIL pour la journalisation (6 mois à 1 an).
/var/log/nginx/access.log /var/log/nginx/error.log {
	daily
	rotate 183
	maxage 183
	missingok
	compress
	delaycompress
	notifempty
	create 0640 www-data adm
	sharedscripts
	prerotate
		if [ -d /etc/logrotate.d/httpd-prerotate ]; then \
			run-parts /etc/logrotate.d/httpd-prerotate; \
		fi \
	endscript
	postrotate
		invoke-rc.d nginx rotate >/dev/null 2>&1
	endscript
}

# Logs de métriques (log_format odos_metrics) : ni IP ni query string, lus en
# continu par nginxlog-exporter. Une semaine suffit.
/var/log/nginx/odos-metrics-*.log {
	daily
	rotate 7
	missingok
	compress
	delaycompress
	notifempty
	create 0640 www-data adm
	sharedscripts
	postrotate
		invoke-rc.d nginx rotate >/dev/null 2>&1
	endscript
}
