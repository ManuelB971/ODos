# /etc/logrotate.d/rsyslog — remplace le fichier du paquet (Ubuntu 24.04).
# Procédure : docs/ops/RUNBOOK_DURCISSEMENT_HOTE.md § 6
#
# auth.log (connexions SSH, sudo : IP et comptes) sort du bloc commun pour être
# gardé 6 mois (26 semaines), recommandation CNIL sur la journalisation
# (6 mois à 1 an). Les autres journaux gardent la valeur du paquet (4 semaines).
/var/log/auth.log
{
	rotate 26
	weekly
	missingok
	notifempty
	compress
	delaycompress
	sharedscripts
	postrotate
		/usr/lib/rsyslog/rsyslog-rotate
	endscript
}

/var/log/syslog
/var/log/mail.log
/var/log/kern.log
/var/log/user.log
/var/log/cron.log
{
	rotate 4
	weekly
	missingok
	notifempty
	compress
	delaycompress
	sharedscripts
	postrotate
		/usr/lib/rsyslog/rsyslog-rotate
	endscript
}
